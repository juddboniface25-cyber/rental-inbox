# Secret used to open /inbox and authorize inbox API routes.
# Visit /inbox and enter this value. It is stored in an httpOnly cookie.
INBOX_SECRET=change-me-to-a-long-random-string

# Optional: email the owner when a guest submits an inquiry.
# Guest submit always succeeds even if these are unset or email fails.
# OWNER_EMAIL=you@example.com
# RESEND_API_KEY=re_xxxxxxxx
